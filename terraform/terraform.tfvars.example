db_password = "Abcd1234EfghIjkl"
# db_username = "postgres"

# Ubuntu 24.04 LTS AMI ID for eu-north-1. Find it with:
#   aws ec2 describe-images --region eu-north-1 \
#     --owners 099720109477 \
#     --filters "Name=name,Values=ubuntu/images/hvm-ssd-gp3/ubuntu-noble-24.04-amd64-server-*" \
#     --query "sort_by(Images, &CreationDate)[-1].ImageId" --output text
ami_id = "ami-0123456789abcdef0"

# Name of an existing EC2 key pair in eu-north-1 (name only, no .pem)
key_name = "my-keypair"

# Email that receives CloudWatch alarm notifications.
# AWS sends a confirmation email after apply. Click the link in it.
alert_email = "you@example.com"
